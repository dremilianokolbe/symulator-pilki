{
  "name": "symulator-pilki",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Symulator piłki nożnej: silnik meczu, rozgrywki, kariera.",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "mecz": "tsx scripts/mecz.ts",
    "kalibracja": "tsx scripts/kalibracja.ts",
    "dane:pobierz": "bash scripts/dane/pobierz.sh",
    "dane:przetworz": "tsx scripts/dane/przetworz.ts && tsx scripts/dane/kadry-pelne.ts",
    "kalibracja:euro": "tsx scripts/kalibracja-euro.ts",
    "euro": "tsx scripts/euro2016.ts",
    "kariera": "tsx scripts/kariera.ts",
    "app": "vite --config app/vite.config.ts",
    "app:build": "vite build --config app/vite.config.ts",
    "app:typecheck": "tsc --noEmit -p app/tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
